FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 PYTHONHASHSEED=0 \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential vim && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir torch==2.2.0 \
      --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir "ray[rllib]==2.10.0"

WORKDIR /opt/cage
COPY repos/cage-challenge-4/ /opt/cage/cage-challenge-4/
RUN cd cage-challenge-4 && pip install --no-cache-dir -r Requirements.txt && pip install --no-cache-dir -e .

COPY repos/Hierarchical-MARL/ /opt/cage/Hierarchical-MARL/

VOLUME /data
CMD ["/bin/bash"]
